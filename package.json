{
  "name": "hieducation",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node --use-env-proxy --env-file-if-exists=.env --disable-warning=ExperimentalWarning server.js",
    "dev": "node --use-env-proxy --env-file-if-exists=.env --watch server.js",
    "test": "node --test",
    "release": "node scripts/release.mjs",
    "check-ready": "node scripts/check-ready.mjs",
    "test:browser": "node scripts/browser-runner.cjs",
    "test:docker": "node scripts/docker-smoke.cjs"
  },
  "engines": {
    "node": ">=24.5"
  }
}
