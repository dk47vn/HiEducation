# Copy to .env and set credentials locally; never commit .env.
PORT=3000
# Required for administration. Use a long random secret, not a shared example.
ADMIN_TOKEN=
# Set true behind HTTPS before public deployment.
COOKIE_SECURE=false
# Optional AI provider credentials. Do not enter keys in browser or chat.
HI_AI_API_KEY=
HI_AI_TEXT_MODEL=gpt-4.1-mini
HI_AI_IMAGE_MODEL=gpt-image-1
# Set only to a video model enabled for your provider account.
HI_AI_VIDEO_MODEL=
# Required HTTPS origin for production metadata and sitemap.
PUBLIC_ORIGIN=https://hi.edu.vn
# Used by Docker Compose / Caddy after DNS points to your server.
SITE_DOMAIN=hi.edu.vn
